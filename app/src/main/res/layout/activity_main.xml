<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1115">

    <!-- 🌐 1. Sleek Minimal Omnibox Header -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="#0F1115"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Omnibox Capsule Container -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_omnibox"
            android:paddingHorizontal="12dp">

            <!-- Security / Lock Icon -->
            <ImageView
                android:id="@+id/ivSecurityStatus"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_lock_secure"
                android:contentDescription="Status Keamanan"
                android:layout_marginEnd="8dp" />

            <!-- Address Input -->
            <EditText
                android:id="@+id/urlEditText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Cari atau masukkan tautan web..."
                android:textColorHint="#64748B"
                android:textColor="#F1F5F9"
                android:textSize="13sp"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Reload / Refresh Button -->
            <ImageButton
                android:id="@+id/btnRefresh"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_refresh_nav"
                android:contentDescription="Muat Ulang"
                android:padding="4dp" />
        </LinearLayout>

        <!-- Quick New Tab Action -->
        <ImageButton
            android:id="@+id/btnNewTabTop"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_add_tab"
            android:contentDescription="Tab Baru"
            android:padding="8dp" />
    </LinearLayout>

    <!-- Subtle Progress Line -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:progressDrawable="@drawable/progress_bar_custom"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <!-- 🖥️ 2. Multi-Tab WebView Viewport -->
    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#0F1115"
        app:layout_constraintTop_toBottomOf="@id/progressBar"
        app:layout_constraintBottom_toTopOf="@id/bottomBar" />

    <!-- ⚡ 3. Dynamic Media Capsule (Modern Island Pill) -->
    <!-- Tidak lagi menutupi layar atau tombol web, muncul anggun di atas bottom bar -->
    <LinearLayout
        android:id="@+id/capsuleDownload"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_capsule_download"
        android:clickable="true"
        android:focusable="true"
        android:elevation="8dp"
        android:layout_marginBottom="14dp"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_download_stream"
            app:tint="#10B981"
            android:contentDescription="Media Siap" />

        <TextView
            android:id="@+id/tvCapsuleLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unduh Media • Siap"
            android:textColor="#F1F5F9"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- 📱 4. Ergonomic Bottom Navigation Bar (Thumb Zone) -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_bottom_nav"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Back -->
        <ImageButton
            android:id="@+id/btnNavBack"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Kembali"
            android:padding="14dp" />

        <!-- Forward -->
        <ImageButton
            android:id="@+id/btnNavForward"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_forward"
            android:contentDescription="Maju"
            android:padding="14dp" />

        <!-- Home -->
        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_home_nav"
            android:contentDescription="Beranda"
            android:padding="14dp" />

        <!-- Tab Switcher (Modern Rounded Square with Counter) -->
        <FrameLayout
            android:id="@+id/btnTabSwitcher"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_tab_badge_modern">

                <TextView
                    android:id="@+id/tvTabCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="1"
                    android:textColor="#F1F5F9"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </FrameLayout>

        <!-- More Menu (3 Dots) -->
        <ImageButton
            android:id="@+id/btnMoreMenu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_nav"
            android:contentDescription="Menu"
            android:padding="15dp" />
    </LinearLayout>

    <!-- 📑 5. Tab Switcher Overlay (Card Grid Studio Style) -->
    <LinearLayout
        android:id="@+id/tabSwitcherOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#0F1115"
        android:padding="16dp"
        android:visibility="gone"
        tools:visibility="gone">

        <!-- Top Header Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvTabSwitcherHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tab Aktif (1)"
                android:textColor="#F1F5F9"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- New Tab Pill Button -->
            <Button
                android:id="@+id/btnTabSwitcherNew"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="+ Tab Baru"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#0F1115"
                android:backgroundTint="#10B981"
                android:layout_marginEnd="6dp" />

            <!-- Close Tab Switcher -->
            <ImageButton
                android:id="@+id/btnCloseTabSwitcher"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close_tab"
                android:contentDescription="Tutup"
                android:padding="8dp" />
        </LinearLayout>

        <!-- Scrollable Tab Cards -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/tabListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp" />
        </ScrollView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
