<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_modern"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- 1. Sleek Top Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_drag_handle"
        android:layout_marginBottom="16dp" />

    <!-- 2. Platform Category Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvPlatformBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TIKTOK NO-WATERMARK"
            android:textColor="#10B981"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:background="@drawable/bg_badge_pill" />
    </LinearLayout>

    <!-- 3. Clean Media Title -->
    <TextView
        android:id="@+id/tvMediaTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Judul Media Sedang Diputar..."
        android:textColor="#F1F5F9"
        android:textSize="16sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginBottom="18dp" />

    <!-- 4. Option 1: Video HD Direct -->
    <LinearLayout
        android:id="@+id/optVideoHd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_download_card_modern"
        android:clickable="true"
        android:focusable="true"
        android:padding="14dp"
        android:layout_marginBottom="10dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_video_hd"
            android:contentDescription="HD Video"
            android:padding="6dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Video Resolusi Penuh"
                android:textColor="#F1F5F9"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kualitas jernih terbaik, direct stream"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1080p HD"
            android:textColor="#10B981"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_pill" />
    </LinearLayout>

    <!-- 5. Option 2: Video Saver -->
    <LinearLayout
        android:id="@+id/optVideoSaver"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_download_card_modern"
        android:clickable="true"
        android:focusable="true"
        android:padding="14dp"
        android:layout_marginBottom="10dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_video_fast"
            android:contentDescription="Saver Video"
            android:padding="6dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Video Hemat Kuota"
                android:textColor="#F1F5F9"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ukuran lebih ringan, cepat selesai"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HEMAT"
            android:textColor="#0EA5E9"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_pill" />
    </LinearLayout>

    <!-- 6. Option 3: Audio Saja (M4A / MP3) -->
    <LinearLayout
        android:id="@+id/optAudio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_download_card_modern"
        android:clickable="true"
        android:focusable="true"
        android:padding="14dp"
        android:layout_marginBottom="14dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_audio_track"
            android:contentDescription="Audio Saja"
            android:padding="6dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Audio Saja (M4A / MP3)"
                android:textColor="#F1F5F9"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ekstrak musik suara jernih bitrate tinggi"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AUDIO"
            android:textColor="#A855F7"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_pill" />
    </LinearLayout>

    <!-- 7. Action Row: Salin Link & Server Cadangan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/btnCopyLink"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_btn_action_pill"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="6dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_copy_link"
                android:contentDescription="Salin Tautan"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Salin Tautan"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnAltServer"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_btn_action_pill"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="6dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_external_cloud"
                android:contentDescription="Server Cadangan"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pengunduh Cepat"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
